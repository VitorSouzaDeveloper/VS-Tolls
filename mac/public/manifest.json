{
  "name": "VS Drop — Transferência Mac & Celular",
  "short_name": "VS Drop",
  "description": "Transferência ultrarrápida ponto a ponto via Wi-Fi local sem limites",
  "start_url": "/drop",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c0d10",
  "theme_color": "#0c0d10",
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    }
  ],
  "share_target": {
    "action": "/drop",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shared_files",
          "accept": ["*/*"]
        }
      ]
    }
  }
}

