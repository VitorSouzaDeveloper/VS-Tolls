{
  "name": "vs-tolls",
  "version": "1.0.0",
  "description": "VS Tolls — Diagnóstico de hardware, sensores, placa de vídeo, benchmarks, jogos e ferramentas para macOS e Windows.",
  "main": "mac/main.js",
  "scripts": {
    "start": "electron mac/main.js",
    "web": "node mac/server.js",
    "mac": "./run-mac.sh",
    "build:mac": "electron-builder --mac --arm64 && codesign --force --deep --sign - \"dist/mac-arm64/VS Tolls.app\" && xattr -cr \"dist/mac-arm64/VS Tolls.app\"",
    "build:mac:dir": "electron-builder --mac --arm64 --dir && codesign --force --deep --sign - \"dist/mac-arm64/VS Tolls.app\" && xattr -cr \"dist/mac-arm64/VS Tolls.app\"",
    "build:mac:all": "electron-builder --mac --arm64 --x64"
  },
  "build": {
    "appId": "com.vstolls.app",
    "productName": "VS Tolls",
    "copyright": "Copyright © 2026 Vitor Souza",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "mac/assets/app.icns",
      "target": [
        "dir",
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "VS Tolls ${version}",
      "icon": "mac/assets/app.icns",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "mac/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitorSouzaDeveloper/VS-Tolls.git"
  },
  "keywords": [
    "hardware",
    "benchmark",
    "diagnostics",
    "apple-silicon",
    "macos",
    "gaming",
    "vs-tolls"
  ],
  "author": "Vitor Souza",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
